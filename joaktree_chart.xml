<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">

    <name>com_joaktree_chart</name>
    <element>com_joaktree_chart</element>

    <author>Van Leeuwen Webdesign</author>
    <creationDate>October 2026</creationDate>
    <copyright>(C) Van Leeuwen Webdesign</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>fwtvanleeuwen@gmail.com</authorEmail>
    <description>Interactive graphical family tree visualization based on genealogy data from Joaktree for Joomla 6.</description>

    <version>1.0.0</version>

    <namespace path="src">VanLeeuwenWebdesign\Component\JoaktreeChart</namespace>

    <administration>
        <files folder="administrator">
            <folder>services</folder>
            <folder>src</folder>
        </files>
    </administration>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.com_joaktree_chart.sys.ini</language>
        <language tag="nl-NL">nl-NL/nl-NL.com_joaktree_chart.sys.ini</language>
    </languages>

    <files folder="site">
        <filename>joaktree_chart.php</filename>

        <folder>language</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <media destination="com_joaktree_chart" folder="media/com_joaktree_chart">
        <folder>css</folder>
        <folder>js</folder>
    </media>

</extension>
